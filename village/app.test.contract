// The menus and HUD on a host: `bun exact.mjs test web` (also macos, ios).
// Gameplay is tested hostless in logic/tests: `bun exact.mjs test-rust`.
test "Play starts the village with its HUD"
  expect tree has "play"
  tap "play"
  expect tree has "world"
  clock +500
  expect text "hud-gold" == "🪙 500 / 1000"
  expect text "hud-th" == "Town Hall 1"

test "Buying then cancelling spends nothing"
  tap "play"
  clock +500
  tap "shop-open"
  expect tree has "shop"
  tap "buy-goldmine"
  clock +200
  expect tree has "placing"
  tap "cancel"
  clock +200
  expect text "hud-elixir" == "💧 500 / 1000"

test "Dev shortcut raises the Town Hall"
  tap "play"
  clock +500
  tap "dev-th"
  clock +200
  expect text "hud-th" == "Town Hall 2"

test "A raid: pick a camp, drop troops, see the result, go home"
  tap "play"
  clock +500
  tap "raid-open"
  expect tree has "campaign"
  tap "dev-army"
  clock +200
  tap "attack-0"
  clock +200
  expect tree has "raid-top"
  expect tree has "deploy"
  expect tree has "surrender"
  tap "surrender"
  clock +300
  expect tree has "result"
  expect text "result-stars" == "⭐ 0 / 3 · 0% destroyed"
  tap "home"
  clock +200
  expect tree has "raid-open"

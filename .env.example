# =============================================================================
# reddit-idea-engine — environment variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Reddit API
# Create an app at https://www.reddit.com/prefs/apps (select "script" type).
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
# Reddit requires a descriptive user-agent string.
REDDIT_USER_AGENT=reddit-idea-engine/1.0 by u/your_reddit_username

# -----------------------------------------------------------------------------
# Subreddits to monitor (comma-separated, no spaces around commas)
# -----------------------------------------------------------------------------
SUBREDDITS=SaaS,startups,entrepreneur,smallbusiness

# Number of "hot" posts to fetch from each subreddit per run
POSTS_PER_SUBREDDIT=25

# -----------------------------------------------------------------------------
# Post filter thresholds
# Posts below these thresholds are stored but NOT sent to OpenAI for scoring.
# -----------------------------------------------------------------------------
MIN_SCORE=10
MIN_COMMENTS=5

# Optional keyword filter: only evaluate posts whose title or body contains at
# least one of these keywords.  Leave empty to evaluate all qualifying posts.
# Example: KEYWORDS=idea,problem,pain,build,struggling
KEYWORDS=

# -----------------------------------------------------------------------------
# OpenAI
# https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
# gpt-4o-mini is fast and cheap; switch to gpt-4o for higher-quality analysis.
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Supabase
# Found in: Supabase Dashboard → Project Settings → API
# Use the service_role key for backend writes; anon key works if RLS is off.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
